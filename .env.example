# Keep secrets only in this local file; never share it or commit it.
DISCORD_TOKEN=REPLACE_WITH_NEW_ROTATED_TOKEN
DISCORD_GUILD_ID=0
DEALS_CHANNEL_ID=0
DATABASE_PATH=data/deals.sqlite3
CHECK_MINUTES=30
MIN_DISCOUNT_PERCENT=70
MAX_PENNY_PRICE=1.00
MAX_OBSERVATION_AGE_MINUTES=120
# Comma-separated HTTPS RSS feeds you are permitted to read. Empty by default.
RSS_FEED_URLS=
# Optional authorized structured deal JSON provider
DEAL_FEED_URL=
DEAL_FEED_BEARER_TOKEN=
# Optional store directory CSV from authorized source
WALMART_STORES_CSV=walmart_stores.csv
ZIP_LOOKUP_ENABLED=true

# Optional category channels; falls back to DEALS_CHANNEL_ID
AMAZON_DEALS_CHANNEL_ID=0
WALMART_DEALS_CHANNEL_ID=0
PRICE_ERRORS_CHANNEL_ID=0
PENNY_DEALS_CHANNEL_ID=0
COUPON_DEALS_CHANNEL_ID=0

# Free public OpenStreetMap store discovery fallback (community data, incomplete)
OSM_STORE_DISCOVERY=true

# Gardener room configuration database
GARDENER_DATABASE_PATH=gardener.sqlite3

# Optional: separate persistent database for the 20 Questions game
# GARDENER_QUESTIONS_DATABASE_PATH=data/gardener_questions.sqlite3
